# ============================================
# ETINBOT ADMIN — environment variables
# ============================================
# Skopiuj do .env.local i uzupelnij.

# --- DB ---
# Ten sam Postgres co EtinBOT backend (Coolify etinbot-postgres).
DATABASE_URL="postgresql://etinbot:PASSWORD@localhost:5433/etinbot"

# --- NEXTAUTH ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""  # openssl rand -base64 32

# --- EtinBOT backend ---
BOT_API_URL="https://etinbot.dewflow.cloud"
# NIGDY nie commituj realnego klucza — wartość z Coolify env EtinBOT (KB_API_KEY)
BOT_API_KEY="etinbot-kb-xxxxxxxxxxxxxxxx"

# --- Client (multi-tenant) ---
CLIENT_ID="a5401b5c-8fcc-4519-94e5-0fd1cfe786cd"
CLIENT_SLUG="krainaherbaty"
